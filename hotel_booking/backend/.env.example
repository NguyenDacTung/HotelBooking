DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD='YOUR_LOCAL_POSTGRESQL_PASSWORD'
DB_NAME=hotel_booking
# Alternative: DATABASE_URL=postgresql+psycopg://USER:ENCODED_PASSWORD@localhost:5432/hotel_booking
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=uploads
# Seed only: choose a local demonstration password, never use a real password.
# DEMO_PASSWORD=
# manage_local.py test-postgres derives hotel_booking_test from the same local credentials.
# Development-only TTTP seed: at least 8 characters; existing accounts are preserved.
# TTTP_ADMIN_PASSWORD=
# Password for accounts added by scripts/seed_recording_data.py --apply.
# Generated/stored locally if absent; never changes existing account passwords.
# TETRA_RECORDING_PASSWORD=
# TTTP_STAFF_PASSWORD=
# TTTP_CUSTOMER_PASSWORD=
# GOOGLE_CLIENT_ID=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_GRAPH_VERSION=v24.0
# REPORT_FONT_PATH=C:/Windows/Fonts/arial.ttf
# Optional recovery email. Keep credentials only in backend/.env.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Optional FCM server: absolute path to service-account JSON outside shared code.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=
CHECKIN_HOUR=14
CHECKOUT_HOUR=12
HOLD_HOURS=24
EXTRA_BED_PRICE=250000

# Integration v3: keep all secrets on backend. Public URL must be real HTTPS.
PRIVATE_UPLOAD_DIR=private_uploads
PERSISTENT_MEDIA_ENABLED=true
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_PUBLIC_BASE_URL=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
