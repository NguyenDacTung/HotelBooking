{
  "version": "0.2.0",
  "configurations": [{
    "name": "TETRA - flutter run (USB / Emulator)",
    "request": "launch",
    "type": "dart",
    "program": "lib/main.dart",
    "preLaunchTask": "TETRA: start localhost backend"
  }, {
    "name": "TTTP - WiFi LAN - API PostgreSQL",
    "request": "launch",
    "type": "dart",
    "program": "lib/main.dart",
    "preLaunchTask": "TTTP: start WiFi backend",
    "toolArgs": ["--dart-define=DEMO_MODE=false", "--dart-define=API_BASE_URL=${input:apiBaseUrl}"]
  }, {
    "name": "TTTP - USB localhost (chi dung khi cam cap)",
    "request": "launch",
    "type": "dart",
    "program": "lib/main.dart",
    "preLaunchTask": "TTTP: start backend and USB API",
    "toolArgs": ["--dart-define=DEMO_MODE=false", "--dart-define=API_BASE_URL=http://127.0.0.1:8000"]
  }],
  "inputs": [{
    "id": "apiBaseUrl",
    "type": "promptString",
    "description": "Backend API URL reachable from the phone (use the computer's current LAN IP)"
  }]
}
