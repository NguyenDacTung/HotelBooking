{
  "version": "2.0.0",
  "tasks": [{
    "label": "TETRA: start localhost backend",
    "type": "process",
    "command": "powershell.exe",
    "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/start_backend.ps1"],
    "problemMatcher": []
  }, {
    "label": "TTTP: start WiFi backend",
    "type": "process",
    "command": "powershell.exe",
    "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/start_backend.ps1", "-Lan", "-InterfaceAlias", "${input:networkInterface}"],
    "problemMatcher": []
  }, {
    "label": "TTTP: start backend and USB API",
    "type": "process",
    "command": "powershell.exe",
    "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/start_phone_api.ps1"],
    "problemMatcher": []
  }],
  "inputs": [{
    "id": "networkInterface",
    "type": "promptString",
    "description": "Private network interface name (check Get-NetConnectionProfile)",
    "default": "Wi-Fi"
  }]
}
